<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="@dimen/dashboard_header_height" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="@dimen/dashboard_header_padding" android:paddingEnd="@dimen/dashboard_header_padding" android:background="@color/card">
    <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/header_logo_badge" android:foregroundGravity="center">
        <ImageView android:layout_width="42dp" android:layout_height="22dp" android:layout_gravity="center" android:contentDescription="TOPITUP" android:scaleType="fitCenter" android:src="@drawable/topitup_logo" android:tint="@color/on_primary" />
    </FrameLayout>
    <LinearLayout android:id="@+id/account_info_panel" android:layout_width="0dp" android:layout_height="50dp" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/header_account_panel" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/account_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Demo Test Account [PTG999]" android:textColor="@color/on_surface" android:textSize="13sp" android:textStyle="bold" />
            <ImageView android:id="@+id/account_verified" android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="6dp" android:contentDescription="Verified" android:src="@drawable/ic_verified" />
        </LinearLayout>
        <TextView android:id="@+id/store_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="# Stores in Group: 1" android:textColor="@color/dashboard_secondary" android:textSize="10sp" />
    </LinearLayout>
    <ImageButton android:id="@+id/wallet_action" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="8dp" android:background="@drawable/header_wallet_button" android:contentDescription="Wallet" android:padding="11dp" android:src="@drawable/ic_header_wallet" android:tint="@color/on_primary" />
    <ImageButton android:id="@+id/logout_action" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="6dp" android:background="@drawable/header_power_button" android:contentDescription="Log out" android:padding="10dp" android:src="@drawable/ic_power" />
</LinearLayout>